<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Categories</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <%- include('navbar')%>
    <% categories.map((category) => {%>
        <a href="/items?category=<%=category.id%>"><div class="overview"><%=category.name%></div></a>
    <%})%>
    <a href="/categories/create"><button>Create</button></a>
    <a href="/categories/edit"><button>Edit</button></a>
    <a href="/categories/delete"><button class="delete">Delete</button></a>
</body>
</html>